<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="turtlebot3_lime_system" params="name prefix use_sim:=^|false use_fake_hardware:=^|false fake_sensor_commands:=^|false">

    <ros2_control name="${name}" type="system">

      <xacro:if value="$(arg use_sim)">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <hardware>
          <xacro:if value="${use_fake_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="fake_sensor_commands">${fake_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>
          <xacro:unless value="${use_fake_hardware}">
            <plugin>turtlebot3_lime_hardware/TurtleBot3LimeSystemHardware</plugin>
            <param name="opencr_id">200</param>
            <param name="opencr_usb_port">/dev/ttyACM0</param>
            <param name="opencr_baud_rate">1000000</param>
            <param name="dxl_joints_profile_acceleration">100</param>
            <param name="dxl_joints_profile_velocity">500</param>
            <param name="dxl_gripper_profile_acceleration">20</param>
            <param name="dxl_gripper_profile_velocity">200</param>
          </xacro:unless>
        </hardware>
      </xacro:unless>

      <!-- Wheel joints and hardware sensors: excluded when use_sim=true.
           Wheels are driven by gz-sim-diff-drive-system; IMU/battery are hardware-only. -->
      <xacro:unless value="$(arg use_sim)">
        <joint name="${prefix}wheel_left_joint">
          <command_interface name="velocity">
            <param name="min">-24.5</param>
            <param name="max">24.5</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
        <joint name="${prefix}wheel_right_joint">
          <command_interface name="velocity">
            <param name="min">-24.5</param>
            <param name="max">24.5</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>

        <sensor name="tb3_imu">
          <state_interface name="orientation.x">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="orientation.y">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="orientation.z">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="orientation.w">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="angular_velocity.x">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="angular_velocity.y">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="angular_velocity.z">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="linear_acceleration.x">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="linear_acceleration.y">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="linear_acceleration.z">
            <param name="initial_value">0.0</param>
          </state_interface>
        </sensor>

        <sensor name="battery">
          <state_interface name="voltage">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="percentage">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="design_capacity">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="present">
            <param name="initial_value">0.0</param>
          </state_interface>
        </sensor>
      </xacro:unless>

      <!-- Arm joints: always present (gz_ros2_control/GazeboSimSystem manages these in sim) -->
      <joint name="${prefix}joint1">
        <command_interface name="position">
          <param name="min">${-pi*0.9}</param>
          <param name="max">${pi*0.9}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}joint2">
        <command_interface name="position">
          <param name="min">${-pi*0.541}</param>
          <param name="max">${pi*0.562}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}joint3">
        <command_interface name="position">
          <param name="min">${-pi*0.560}</param>
          <param name="max">${pi*0.591}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}joint4">
        <command_interface name="position">
          <param name="min">${-pi*0.5}</param>
          <param name="max">${pi*0.5}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}joint5">
        <command_interface name="position">
          <param name="min">${-pi*0.531}</param>
          <param name="max">${pi*0.567}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}joint6">
        <command_interface name="position">
          <param name="min">${-pi*0.9}</param>
          <param name="max">${pi*0.9}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}gripper_left_joint">
        <command_interface name="position">
          <param name="min">-0.010</param>
          <param name="max">0.019</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}gripper_right_joint">
        <param name="mimic">gripper_left_joint</param>
        <param name="multiplier">1</param>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
