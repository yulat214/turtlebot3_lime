<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="open_manipulator_sara_gazebo" params="prefix">

    <!-- Link contact/friction properties (classic-compatible, used for ODE physics) -->
    <xacro:macro name="Link" params="reference">
      <gazebo reference="${reference}">
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <mu1>30.0</mu1>
        <mu2>30.0</mu2>
        <maxVel>1.0</maxVel>
        <minDepth>0.001</minDepth>
      </gazebo>
    </xacro:macro>

    <xacro:Link reference="${prefix}link1"/>
    <xacro:Link reference="${prefix}link2"/>
    <xacro:Link reference="${prefix}link3"/>
    <xacro:Link reference="${prefix}link4"/>
    <xacro:Link reference="${prefix}link5"/>
    <xacro:Link reference="${prefix}link6"/>
    <xacro:Link reference="${prefix}link7"/>

    <xacro:Link reference="${prefix}gripper_left_link"/>
    <xacro:Link reference="${prefix}gripper_right_link"/>

  </xacro:macro>

</robot>
